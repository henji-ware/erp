// ERP + CRM unificado — schema do banco de dados (PostgreSQL / Vercel + Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // conexão (pooled) usada em runtime
  directUrl = env("DATABASE_URL_UNPOOLED") // conexão direta (injetada pela Vercel/Neon)
}

// --------------------------- Enums -----------------------------
// Valores fechados (antes eram String livre). Garantem integridade no banco:
// um valor inválido não pode mais ser gravado por engano.

enum ProductKind {
  PRODUCT
  SERVICE
}

enum ContractType {
  CLT
  PJ
}

enum ProjectType {
  ENGENHARIA
  INSPECAO
  MONTAGEM
  REMANEJAMENTO
  MANUTENCAO
  VENDA
  LOCACAO
}

enum ProjectStatus {
  ORCAMENTO
  APROVADO
  EM_EXECUCAO
  CONCLUIDO
  CANCELADO
}

enum InspectionStatus {
  AGENDADA
  REALIZADA
  LAUDO_EMITIDO
}

enum RiskLevel {
  VERDE
  AMARELO
  VERMELHO
}

enum AppointmentType {
  VISIT
  MEETING
}

enum AppointmentStatus {
  SCHEDULED
  DONE
  CANCELLED
}

enum LeadStage {
  NEW
  CONTACTED
  PROPOSAL
  WON
  LOST
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  INVOICED
  CANCELLED
}

enum TransactionType {
  RECEIVABLE
  PAYABLE
}

enum TransactionStatus {
  PENDING
  PARTIAL
  PAID
}

enum PaymentMethod {
  CARD_CREDIT
  CARD_DEBIT
  PIX
  BOLETO
  CASH
}

enum RentalStatus {
  ACTIVE // em locação
  RETURNED // devolvido
  OVERDUE // atrasado (passou da data prevista)
  CANCELLED
}

enum MaintenanceFrequency {
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum MaintenanceStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum UserRole {
  ADMIN // Gustavo, Durval — veem e gerenciam tudo
  USER // veem e editam só os próprios orçamentos
}

enum SellerCategory {
  VENDEDOR
  REPRESENTANTE
  DISTRIBUIDOR
  PARCEIRO
}

enum LeadLossReason {
  PRAZO_ENTREGA
  PRECO
  PRODUTO
  OUTRO_FORNECEDOR
  OUTRO
}

// --------------------------- Acesso ----------------------------

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  leads        Lead[]   @relation("LeadOwner")
}

// Contador sequencial por chave (ex.: "2606" = orçamentos de jun/2026).
model Counter {
  key   String @id
  value Int    @default(0)
}

// ----------------------- Log de auditoria ----------------------

// Trilha de quem criou/alterou/excluiu cada registro. action:
// CREATE | UPDATE | DELETE | STATUS
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  userName  String? // nome "congelado" (sobrevive se o usuário for removido)
  action    String
  entity    String // "Projeto", "Cliente", "Pedido"...
  entityId  Int?
  summary   String? // descrição legível ("Projeto PRJ-X criado")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ---------------------------- RH -------------------------------

model Employee {
  id           Int           @id @default(autoincrement())
  name         String
  role         String? // cargo
  department   String?
  email        String?
  phone        String?
  contractType ContractType  @default(CLT)
  category     SellerCategory? // vendedor, representante, distribuidor, parceiro
  salary       Float         @default(0)
  commissionPct Float        @default(0) // percentual de comissão sobre vendas
  targetValue  Float?        // meta de faturamento (mensal)
  targetQty    Int?          // meta de quantidade de vendas (mensal)
  benefits     String? // benefícios (VR, VT, plano de saúde…)
  hireDate     DateTime?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  sales        Order[]       @relation("Seller")
  projects     Project[]     @relation("ProjectResponsible")
  appointments Appointment[]
}

// --------------------- Projetos / Obras ------------------------

// type: ENGENHARIA | INSPECAO | MONTAGEM | REMANEJAMENTO | MANUTENCAO | VENDA | LOCACAO
// status: ORCAMENTO | APROVADO | EM_EXECUCAO | CONCLUIDO | CANCELADO
model Project {
  id            Int           @id @default(autoincrement())
  number        String        @unique
  title         String
  type          ProjectType   @default(ENGENHARIA)
  status        ProjectStatus @default(ORCAMENTO)
  customer      Customer      @relation(fields: [customerId], references: [id])
  customerId    Int
  responsible   Employee?     @relation("ProjectResponsible", fields: [responsibleId], references: [id])
  responsibleId Int?
  value         Float         @default(0)
  location      String?
  startDate     DateTime?
  endDate       DateTime?
  notes         String?
  ownerId       Int? // usuário que criou (escopo por dono)
  shared        Boolean       @default(false)
  deletedAt     DateTime? // soft delete (lixeira)
  createdAt     DateTime      @default(now())
  attachments   Attachment[]
  transactions  Transaction[] // faturamento gerado a partir do projeto

  @@index([deletedAt])
  @@index([ownerId])
}

// ------------------- Inspeções e Laudos ------------------------

// status: AGENDADA | REALIZADA | LAUDO_EMITIDO   risk: VERDE | AMARELO | VERMELHO
model Inspection {
  id          Int              @id @default(autoincrement())
  customer    Customer         @relation(fields: [customerId], references: [id])
  customerId  Int
  location    String?
  scheduledAt DateTime
  status      InspectionStatus @default(AGENDADA)
  riskLevel   RiskLevel?
  engineer    String? // engenheiro responsável
  artNumber   String? // número da ART
  findings    String?
  ownerId     Int? // usuário que criou (escopo por dono)
  shared      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  attachments Attachment[]

  @@index([ownerId])
}

// ------------------------ Agendamentos -------------------------

// type: VISIT | MEETING     status: SCHEDULED | DONE | CANCELLED
model Appointment {
  id         Int               @id @default(autoincrement())
  title      String
  type       AppointmentType   @default(MEETING)
  startsAt   DateTime
  status     AppointmentStatus @default(SCHEDULED)
  location   String?
  notes      String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId Int?
  ownerId    Int? // usuário que criou (escopo por dono)
  shared     Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([ownerId])
}

// ------------------------- Fornecedores ------------------------

model Supplier {
  id           Int           @id @default(autoincrement())
  name         String
  document     String? // CPF/CNPJ
  email        String?
  phone        String?
  notes        String?
  deletedAt    DateTime? // soft delete (lixeira)
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@index([deletedAt])
}

// ----------------------------- CRM -----------------------------

model Customer {
  id                   Int                   @id @default(autoincrement())
  name                 String
  email                String?
  phone                String?
  company              String?
  document             String? // CPF/CNPJ
  notes                String?
  ownerId              Int? // usuário que criou (escopo por dono)
  shared               Boolean               @default(false) // visível a todos os usuários
  deletedAt            DateTime? // soft delete (lixeira): preenchido = arquivado
  createdAt            DateTime              @default(now())
  orders               Order[]
  leads                Lead[]
  transactions         Transaction[]
  appointments         Appointment[]
  projects             Project[]
  inspections          Inspection[]
  rentals              Rental[]
  maintenanceContracts MaintenanceContract[]

  @@index([deletedAt])
  @@index([ownerId])
}

// Funil de vendas / Orçamentos. stage: NEW | CONTACTED | PROPOSAL | WON | LOST
model Lead {
  id          Int             @id @default(autoincrement())
  number      String?         @unique // numeração sequencial: AAMMNN (ex.: 260601)
  name        String
  email       String?
  phone       String?
  document    String? // CPF/CNPJ
  source      String?
  stage       LeadStage       @default(NEW)
  value       Float           @default(0)
  customer    Customer?       @relation(fields: [customerId], references: [id])
  customerId  Int?
  owner       User?           @relation("LeadOwner", fields: [ownerId], references: [id])
  ownerId     Int? // usuário que criou (para o escopo "vê só o seu")
  lossReason  LeadLossReason? // motivo, quando marcado como Perdido
  lossNote    String? // observação livre sobre a perda
  shared      Boolean         @default(false) // visível a todos os usuários
  attachments Attachment[]
  deletedAt   DateTime? // soft delete (lixeira)
  createdAt   DateTime        @default(now())

  @@index([deletedAt])
  @@index([ownerId])
}

// Anexo (proposta, ART, laudo, contrato em PDF/Word). Pode pertencer a um
// orçamento/lead, a um projeto OU a uma inspeção (apenas um vínculo por anexo).
model Attachment {
  id           Int         @id @default(autoincrement())
  lead         Lead?       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId       Int?
  project      Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    Int?
  inspection   Inspection? @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionId Int?
  fileName     String // nome original do arquivo
  storedName   String // nome único (disco) ou caminho do blob
  url          String? // URL do Vercel Blob (nuvem); vazio = arquivo em disco (local)
  mimeType     String
  size         Int         @default(0)
  createdAt    DateTime    @default(now())

  @@index([leadId])
  @@index([projectId])
  @@index([inspectionId])
}

// -------------------------- Estoque ----------------------------

// kind: PRODUCT | SERVICE  (serviços não controlam estoque)
model Product {
  id        Int         @id @default(autoincrement())
  sku       String      @unique
  name      String
  kind      ProductKind @default(PRODUCT)
  category  String? // Equipamento, Acessório de Segurança, Nível de Carregamento, Serviço
  rentable  Boolean     @default(false) // disponível para locação
  price     Float       @default(0)
  cost      Float       @default(0)
  stock     Int         @default(0)
  deletedAt DateTime? // soft delete (lixeira)
  createdAt DateTime    @default(now())
  items     OrderItem[]
  rentals   Rental[]

  @@index([deletedAt])
}

// --------------------------- Vendas ----------------------------

// status: DRAFT | CONFIRMED | INVOICED | CANCELLED
model Order {
  id           Int           @id @default(autoincrement())
  number       String        @unique
  customer     Customer      @relation(fields: [customerId], references: [id])
  customerId   Int
  seller       Employee?     @relation("Seller", fields: [sellerId], references: [id])
  sellerId     Int?
  status       OrderStatus   @default(DRAFT)
  total        Float         @default(0)
  ownerId      Int? // usuário que criou (escopo por dono)
  shared       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  items        OrderItem[]
  transactions Transaction[]

  @@index([ownerId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  quantity  Int     @default(1)
  unitPrice Float   @default(0)
}

// ------------------------- Financeiro --------------------------

// type: RECEIVABLE | PAYABLE   status: PENDING | PARTIAL | PAID
model Transaction {
  id          Int               @id @default(autoincrement())
  description String
  type        TransactionType
  amount      Float             @default(0)
  dueDate     DateTime
  status      TransactionStatus @default(PENDING)
  order       Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId     Int?
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   Int?
  customer    Customer?         @relation(fields: [customerId], references: [id])
  customerId  Int?
  supplier    Supplier?         @relation(fields: [supplierId], references: [id])
  supplierId  Int?
  ownerId     Int? // usuário que criou (escopo por dono)
  shared      Boolean           @default(false)
  payments    Payment[]
  createdAt   DateTime          @default(now())

  @@index([ownerId])
}

// Pagamentos podem ser parciais. method: CARD_CREDIT | CARD_DEBIT | PIX | BOLETO | CASH
model Payment {
  id            Int           @id @default(autoincrement())
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId Int
  amount        Float         @default(0)
  method        PaymentMethod @default(CASH)
  paidAt        DateTime      @default(now())
  createdAt     DateTime    @default(now())
}

// --------------------------- Locação ---------------------------

// Contrato de aluguel de equipamento. status: ACTIVE | RETURNED | OVERDUE | CANCELLED
model Rental {
  id          Int          @id @default(autoincrement())
  number      String       @unique
  customer    Customer     @relation(fields: [customerId], references: [id])
  customerId  Int
  product     Product      @relation(fields: [productId], references: [id])
  productId   Int
  quantity    Int          @default(1)
  monthlyRate Float        @default(0) // valor mensal por unidade
  startDate   DateTime
  expectedEnd DateTime? // devolução prevista
  returnedAt  DateTime? // devolução efetiva
  status      RentalStatus @default(ACTIVE)
  notes       String?
  ownerId     Int? // usuário que criou (escopo por dono)
  shared      Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@index([status])
  @@index([ownerId])
}

// ------------------- Contratos de manutenção -------------------

// Manutenção recorrente. frequency define o intervalo; nextVisit é a próxima.
model MaintenanceContract {
  id         Int                  @id @default(autoincrement())
  title      String
  customer   Customer             @relation(fields: [customerId], references: [id])
  customerId Int
  frequency  MaintenanceFrequency @default(MONTHLY)
  value      Float                @default(0) // valor por visita
  nextVisit  DateTime?
  status     MaintenanceStatus    @default(ACTIVE)
  notes      String?
  ownerId    Int? // usuário que criou (escopo por dono)
  shared     Boolean              @default(false)
  createdAt  DateTime             @default(now())

  @@index([status])
  @@index([ownerId])
}
