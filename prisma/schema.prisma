// ERP + CRM unificado — schema do banco de dados (PostgreSQL / Vercel + Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // conexão (pooled) usada em runtime
  directUrl = env("DATABASE_URL_UNPOOLED") // conexão direta (injetada pela Vercel/Neon)
}

// --------------------------- Enums -----------------------------
// Valores fechados (antes eram String livre). Garantem integridade no banco:
// um valor inválido não pode mais ser gravado por engano.

enum ProductKind {
  PRODUCT
  SERVICE
}

enum ContractType {
  CLT
  PJ
}

enum ProjectType {
  ENGENHARIA
  INSPECAO
  MONTAGEM
  REMANEJAMENTO
  MANUTENCAO
  VENDA
  LOCACAO
}

enum ProjectStatus {
  ORCAMENTO
  APROVADO
  EM_EXECUCAO
  CONCLUIDO
  CANCELADO
}

enum InspectionStatus {
  AGENDADA
  REALIZADA
  LAUDO_EMITIDO
}

enum RiskLevel {
  VERDE
  AMARELO
  VERMELHO
}

enum AppointmentType {
  VISIT
  MEETING
}

enum AppointmentStatus {
  SCHEDULED
  DONE
  CANCELLED
}

enum LeadStage {
  NEW
  CONTACTED
  PROPOSAL
  WON
  LOST
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  INVOICED
  CANCELLED
}

enum TransactionType {
  RECEIVABLE
  PAYABLE
}

enum TransactionStatus {
  PENDING
  PARTIAL
  PAID
}

enum PaymentMethod {
  CARD_CREDIT
  CARD_DEBIT
  PIX
  BOLETO
  CASH
}

enum RentalStatus {
  ACTIVE // em locação
  RETURNED // devolvido
  OVERDUE // atrasado (passou da data prevista)
  CANCELLED
}

enum MaintenanceFrequency {
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum MaintenanceStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum UserRole {
  ADMIN // Gustavo, Durval — veem e gerenciam tudo
  USER // veem e editam só os próprios orçamentos
}

enum SellerCategory {
  VENDEDOR
  ASSISTENTE_VENDAS
  AUXILIAR_VENDAS
  GERENTE_VENDAS
  REPRESENTANTE
  DISTRIBUIDOR
  PARCEIRO
}

// Tipo de serviço da proposta (define o texto padrão do escopo).
enum ProposalType {
  INSPECAO
  MANUTENCAO
  MATERIAL
  MONTAGEM
  REMANEJAMENTO
  DESMONTAGEM
  SUPERVISAO
  PROJETO
  LOCACAO
}

enum SupplierCategory {
  MATERIA_PRIMA // aço, perfis, chapas
  EQUIPAMENTOS
  COMPONENTES // acessórios e peças
  SERVICOS // montagem, pintura, galvanização…
  TRANSPORTE
  FERRAMENTAS
  EPI // segurança do trabalho
  MANUTENCAO
  OUTROS
}

enum LeadLossReason {
  PRAZO_ENTREGA
  PRECO
  PRODUTO
  OUTRO_FORNECEDOR
  OUTRO
}

// --------------------------- Acesso ----------------------------

model User {
  id            Int          @id @default(autoincrement())
  name          String
  email         String       @unique
  passwordHash  String
  role          UserRole     @default(USER)
  active        Boolean      @default(true)
  emailVerified Boolean      @default(true) // novos usuários nascem false até confirmar
  createdAt     DateTime     @default(now())
  leads         Lead[]       @relation("LeadOwner")
  tokens        EmailToken[]
  aiCredentials AICredential[]
}

/// Chave de API de um provedor de IA, por usuário.
///
/// A chave NUNCA fica em claro: `keyCipher` é AES-256-GCM (ver lib/ai/crypto.ts)
/// e o servidor decifra só no instante de chamar o provedor. O navegador jamais
/// recebe a chave de volta — só `keyHint`, os quatro últimos caracteres, que
/// existem para a pessoa reconhecer QUAL chave está salva.
///
/// Antes isto morava no localStorage do navegador: sumia ao trocar de máquina,
/// era legível por qualquer script da página e viajava no corpo de toda
/// chamada de IA.
model AICredential {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  provider  String // AIProviderId ("anthropic", "gemini", …)
  keyCipher String // v1.<iv>.<tag>.<cifra>
  keyHint   String // últimos 4 caracteres, para exibição
  baseUrl   String? // URL base própria (não é segredo, mas é por usuário)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  // Uma chave por provedor por usuário: salvar de novo substitui a anterior.
  @@unique([userId, provider])
  @@index([userId])
}

// Códigos enviados por e-mail. type: VERIFY (confirmar e-mail) | RESET (trocar senha)
model EmailToken {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  type      String
  code      String // token do link (VERIFY) ou código de 6 dígitos (RESET)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code])
}

// Contador sequencial por chave (ex.: "2606" = orçamentos de jun/2026).
model Counter {
  key   String @id
  value Int    @default(0)
}

// ----------------------- Log de auditoria ----------------------

// Trilha de quem criou/alterou/excluiu cada registro. action:
// CREATE | UPDATE | DELETE | STATUS
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  userName  String? // nome "congelado" (sobrevive se o usuário for removido)
  action    String
  entity    String // "Projeto", "Cliente", "Pedido"...
  entityId  Int?
  summary   String? // descrição legível ("Projeto PRJ-X criado")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ---------------------------- RH -------------------------------

model Employee {
  id           Int           @id @default(autoincrement())
  name         String
  role         String? // cargo
  department   String?
  email        String?
  phone        String?
  contractType ContractType  @default(CLT)
  category     SellerCategory? // vendedor, representante, distribuidor, parceiro
  salary       Float         @default(0)
  commissionPct Float        @default(0) // percentual de comissão sobre vendas
  targetValue  Float?        // meta de faturamento (mensal)
  targetQty    Int?          // meta de quantidade de vendas (mensal)
  benefits     String? // benefícios (VR, VT, plano de saúde…)
  hireDate     DateTime?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt DateTime @updatedAt @default(now())
  sales        Order[]       @relation("Seller")
  projects     Project[]     @relation("ProjectResponsible")
  appointments Appointment[]
}

// --------------------- Projetos / Obras ------------------------

// type: ENGENHARIA | INSPECAO | MONTAGEM | REMANEJAMENTO | MANUTENCAO | VENDA | LOCACAO
// status: ORCAMENTO | APROVADO | EM_EXECUCAO | CONCLUIDO | CANCELADO
model Project {
  id            Int           @id @default(autoincrement())
  number        String        @unique
  title         String
  type          ProjectType   @default(ENGENHARIA)
  status        ProjectStatus @default(ORCAMENTO)
  customer      Customer      @relation(fields: [customerId], references: [id])
  customerId    Int
  responsible   Employee?     @relation("ProjectResponsible", fields: [responsibleId], references: [id])
  responsibleId Int?
  value         Float         @default(0)
  location      String?
  startDate     DateTime?
  endDate       DateTime?
  refCode       String? // nº do orçamento de origem (ex.: 260601)
  notes         String?
  ownerId       Int? // usuário que criou (escopo por dono)
  shared        Boolean       @default(false)
  deletedAt     DateTime? // soft delete (lixeira)
  createdAt     DateTime      @default(now())
  updatedAt DateTime @updatedAt @default(now())
  attachments   Attachment[]
  transactions  Transaction[] // faturamento gerado a partir do projeto

  @@index([deletedAt])
  @@index([ownerId])
}

// ------------------- Inspeções e Laudos ------------------------

// status: AGENDADA | REALIZADA | LAUDO_EMITIDO   risk: VERDE | AMARELO | VERMELHO
model Inspection {
  id          Int              @id @default(autoincrement())
  customer    Customer         @relation(fields: [customerId], references: [id])
  customerId  Int
  location    String?
  scheduledAt DateTime
  status      InspectionStatus @default(AGENDADA)
  riskLevel   RiskLevel?
  engineer    String? // engenheiro responsável
  artNumber   String? // número da ART
  findings    String?
  refCode     String? // nº do orçamento de origem
  ownerId     Int? // usuário que criou (escopo por dono)
  shared      Boolean          @default(false)
  deletedAt   DateTime? // soft delete (lixeira)
  createdAt   DateTime         @default(now())
  updatedAt DateTime @updatedAt @default(now())
  attachments Attachment[]

  @@index([ownerId])
  @@index([deletedAt])
}

// ------------------------ Agendamentos -------------------------

// type: VISIT | MEETING     status: SCHEDULED | DONE | CANCELLED
model Appointment {
  id         Int               @id @default(autoincrement())
  title      String
  type       AppointmentType   @default(MEETING)
  startsAt   DateTime
  status     AppointmentStatus @default(SCHEDULED)
  location   String?
  notes      String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId Int?
  ownerId    Int? // usuário que criou (escopo por dono)
  shared     Boolean   @default(false)
  deletedAt  DateTime? // soft delete (lixeira)
  createdAt  DateTime  @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([ownerId])
  @@index([deletedAt])
}

// ------------------------- Fornecedores ------------------------

model Supplier {
  id           Int               @id @default(autoincrement())
  name         String
  document     String? // CPF/CNPJ
  email        String?
  phone        String?
  category     SupplierCategory? // tipo de fornecedor
  products     String? // o que vende (itens fornecidos)
  services     String? // serviços prestados
  notes        String?
  deletedAt    DateTime? // soft delete (lixeira)
  createdAt    DateTime      @default(now())
  updatedAt DateTime @updatedAt @default(now())
  stockMovements StockMovement[]
  transactions Transaction[]

  @@index([deletedAt])
}

// ----------------------------- CRM -----------------------------

model Customer {
  id                   Int                   @id @default(autoincrement())
  name                 String
  email                String?
  phone                String?
  company              String?
  document             String? // CPF/CNPJ
  address              String? // endereço completo
  notes                String?
  ownerId              Int? // usuário que criou (escopo por dono)
  shared               Boolean               @default(false) // visível a todos os usuários
  deletedAt            DateTime? // soft delete (lixeira): preenchido = arquivado
  createdAt            DateTime              @default(now())
  updatedAt DateTime @updatedAt @default(now())
  orders               Order[]
  leads                Lead[]
  transactions         Transaction[]
  appointments         Appointment[]
  projects             Project[]
  inspections          Inspection[]
  rentals              Rental[]
  maintenanceContracts MaintenanceContract[]

  @@index([deletedAt])
  @@index([ownerId])
}

// Funil de vendas / Orçamentos. stage: NEW | CONTACTED | PROPOSAL | WON | LOST
model Lead {
  id          Int             @id @default(autoincrement())
  number      String?         @unique // numeração sequencial: AAMMNN (ex.: 260601)
  name        String
  email       String?
  phone       String?
  document    String? // CPF/CNPJ
  source      String?
  stage       LeadStage       @default(NEW)
  value       Float           @default(0)
  customer    Customer?       @relation(fields: [customerId], references: [id])
  customerId  Int?
  owner       User?           @relation("LeadOwner", fields: [ownerId], references: [id])
  ownerId     Int? // usuário que criou (para o escopo "vê só o seu")
  lossReason  LeadLossReason? // motivo, quando marcado como Perdido
  lossNote    String? // observação livre sobre a perda
  shared      Boolean         @default(false) // visível a todos os usuários
  attachments Attachment[]
  items       LeadItem[]
  proposals   Proposal[]
  deletedAt   DateTime? // soft delete (lixeira)
  createdAt   DateTime        @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([deletedAt])
  @@index([ownerId])
}

// Proposta comercial gerada a partir de um orçamento. Cada revisão (R0, R1…)
// é um registro, preservando o histórico enviado ao cliente.
model Proposal {
  id            Int          @id @default(autoincrement())
  lead          Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId        Int
  revision      Int          @default(0) // R0, R1, R2…
  type          ProposalType @default(INSPECAO)
  title         String // ex.: "INSPEÇÃO ESTAMPARIA"
  // Destinatário (copiado do cliente, editável na proposta)
  treatment     String       @default("A") // "A", "AO", "À"
  clientName    String
  clientCity    String? // "Santa Isabel/SP"
  contactName   String?
  contactPhone  String?
  contactEmail  String?
  siteLocation  String? // local da obra, quando diferente do endereço do cliente
  showNorms     Boolean      @default(false) // inclui a tabela de normas aplicadas
  // Corpo
  greeting      String? // vocativo ("Prezados (as) Senhores (as)")
  intro         String // "Segue nossa proposta para…"
  scope         String // escopo técnico (texto padrão por tipo, editável)
  // Não conformidades da inspeção (propostas de manutenção): uma por linha,
  // colunas separadas por TAB (colar do Excel) ou "|".
  findings      String?
  included      String? // "Incluso no preço" (uma linha por item)
  notes         String? // observações numeradas
  // Comercial — o preço total é a soma de mão de obra + equipamento + frete +
  // componentes (itens do orçamento, ou o valor fechado quando não há itens).
  amount        Float        @default(0)
  amountLabel   String? // ex.: "VALOR PARA INSPEÇÃO DOS CONJUNTOS"
  laborLabel    String? // ex.: "VALOR TOTAL DA MÃO DE OBRA"
  laborAmount   Float        @default(0)
  equipmentLabel String? // ex.: "Locação de plataforma pantográfica (PTA)"
  equipmentAmount Float      @default(0)
  freightAmount Float        @default(0) // frete de entrega dos componentes
  deadline      String? // prazo de execução dos serviços
  fabricationDeadline String? // prazo de fabricação, quando há fornecimento
  schedule      String? // cronograma (material / montagem), quando aplicável
  paymentTerms  String?
  taxes         String?
  unloading     String? // descarga e movimentação do material na obra
  surfaceTreatment String? // tratamento de superfície e pintura
  colors        String? // cores dos componentes (montante, longarina, acessórios)
  floorNote     String? // cláusula de piso/nivelamento
  warranty      String? // garantia dos materiais e serviços
  purchaseConfirmation String? // condições para início do prazo (confirmação de compra)
  ncm           String? // NCM dos produtos fornecidos
  validityDays  Int          @default(10)
  signedBy      String? // responsável que assina
  signerPhone   String?
  signerEmail   String?
  createdAt     DateTime     @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@unique([leadId, revision])
  @@index([leadId])
}

// Item do orçamento. Pode referenciar um produto/serviço do catálogo ou ser
// uma linha livre (só descrição). O total do orçamento vem da soma dos itens.
model LeadItem {
  id          Int      @id @default(autoincrement())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      Int
  product     Product? @relation(fields: [productId], references: [id])
  productId   Int?
  description String // nome do produto ou texto livre
  quantity    Int      @default(1)
  unitPrice   Float    @default(0)
  createdAt   DateTime @default(now())

  @@index([leadId])
}

// Anexo (proposta, ART, laudo, contrato em PDF/Word). Pode pertencer a um
// orçamento/lead, a um projeto OU a uma inspeção (apenas um vínculo por anexo).
model Attachment {
  id           Int         @id @default(autoincrement())
  lead         Lead?       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId       Int?
  project      Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    Int?
  inspection   Inspection? @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionId Int?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId Int? // notas fiscais / comprovantes do lançamento
  fileName     String // nome original do arquivo
  storedName   String // nome único (disco) ou caminho do blob
  url          String? // URL do Vercel Blob (nuvem); vazio = arquivo em disco (local)
  mimeType     String
  size         Int         @default(0)
  createdAt    DateTime    @default(now())

  @@index([leadId])
  @@index([projectId])
  @@index([inspectionId])
  @@index([transactionId])
}

// -------------------------- Estoque ----------------------------

// kind: PRODUCT | SERVICE  (serviços não controlam estoque)
model Product {
  id        Int         @id @default(autoincrement())
  sku       String      @unique
  name      String
  kind      ProductKind @default(PRODUCT)
  category  String? // Equipamento, Acessório de Segurança, Nível de Carregamento, Serviço
  rentable  Boolean     @default(false) // disponível para locação
  price     Float       @default(0)
  cost      Float       @default(0)
  stock     Int         @default(0)
  deletedAt DateTime? // soft delete (lixeira)
  createdAt DateTime    @default(now())
  updatedAt DateTime @updatedAt @default(now())
  items     OrderItem[]
  leadItems LeadItem[]
  rentals   Rental[]
  movements StockMovement[]

  @@index([deletedAt])
}

// --------------------------- Estoque ---------------------------

// Por que uma movimentação existiu.
enum StockReason {
  ORDER_CONFIRM // baixa pela confirmação de um pedido
  ORDER_REVERSE // devolução pelo cancelamento do pedido
  PURCHASE // entrada por compra de fornecedor
  ADJUSTMENT // acerto manual (inventário, perda, quebra)
}

/// Razão do estoque: uma linha por movimento, nunca editada nem apagada.
///
/// Antes, `Product.stock` era um número solto: quando caía 40 unidades não
/// havia como responder POR QUÊ, nem conferir o saldo contra o histórico.
/// `balance` guarda o saldo DEPOIS do movimento, o que permite auditar a
/// sequência sem recalcular a soma inteira a cada consulta.
model StockMovement {
  id        Int         @id @default(autoincrement())
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  quantity  Int // positivo entra, negativo sai
  balance   Int // saldo resultante, para conferência
  reason    StockReason
  note      String?
  unitCost  Float? // custo unitário, quando é entrada por compra
  supplier  Supplier?   @relation(fields: [supplierId], references: [id])
  supplierId Int?
  order     Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId   Int?
  userId    Int? // quem provocou o movimento
  userName  String? // nome no momento do movimento (o usuário pode sumir)
  createdAt DateTime    @default(now())

  @@index([productId, createdAt])
  @@index([orderId])
}

// --------------------------- Vendas ----------------------------

// status: DRAFT | CONFIRMED | INVOICED | CANCELLED
model Order {
  id           Int           @id @default(autoincrement())
  number       String        @unique
  customer     Customer      @relation(fields: [customerId], references: [id])
  customerId   Int
  seller       Employee?     @relation("Seller", fields: [sellerId], references: [id])
  sellerId     Int?
  status       OrderStatus   @default(DRAFT)
  total        Float         @default(0)
  deliveryAddress String? // endereço de entrega (produtos e serviços)
  refCode      String? // nº do orçamento de origem
  ownerId      Int? // usuário que criou (escopo por dono)
  shared       Boolean       @default(false)
  deletedAt    DateTime? // soft delete (lixeira)
  createdAt    DateTime      @default(now())
  updatedAt DateTime @updatedAt @default(now())
  stockMovements StockMovement[]
  items        OrderItem[]
  transactions Transaction[]

  @@index([ownerId])
  @@index([deletedAt])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  quantity  Int     @default(1)
  unitPrice Float   @default(0)
}

// ------------------------- Financeiro --------------------------

// type: RECEIVABLE | PAYABLE   status: PENDING | PARTIAL | PAID
model Transaction {
  id          Int               @id @default(autoincrement())
  description String
  type        TransactionType
  amount      Float             @default(0)
  dueDate     DateTime
  status      TransactionStatus @default(PENDING)
  order       Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId     Int?
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   Int?
  customer    Customer?         @relation(fields: [customerId], references: [id])
  customerId  Int?
  supplier    Supplier?         @relation(fields: [supplierId], references: [id])
  supplierId  Int?
  ownerId     Int? // usuário que criou (escopo por dono)
  shared      Boolean           @default(false)
  deletedAt   DateTime? // soft delete (lixeira)
  payments    Payment[]
  installments Installment[] // parcelamento (vazio = à vista)
  attachments Attachment[] // notas fiscais e comprovantes
  createdAt   DateTime          @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([ownerId])
  @@index([deletedAt])
}

// Parcela de um lançamento. O lançamento continua único (1 conta), com o
// cronograma de vencimentos aqui — cada parcela tem seu valor e data.
model Installment {
  id            Int         @id @default(autoincrement())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId Int
  number        Int // 1, 2, 3… (ordem de exibição)
  amount        Float       @default(0)
  dueDate       DateTime
  payments      Payment[]
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}

// Pagamentos podem ser parciais. method: CARD_CREDIT | CARD_DEBIT | PIX | BOLETO | CASH
model Payment {
  id            Int           @id @default(autoincrement())
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId Int
  installment   Installment?  @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  installmentId Int? // quando o pagamento quita uma parcela específica
  amount        Float         @default(0)
  method        PaymentMethod @default(CASH)
  paidAt        DateTime      @default(now())
  createdAt     DateTime    @default(now())

  @@index([installmentId])
}

// --------------------------- Locação ---------------------------

// Contrato de aluguel de equipamento. status: ACTIVE | RETURNED | OVERDUE | CANCELLED
model Rental {
  id          Int          @id @default(autoincrement())
  number      String       @unique
  customer    Customer     @relation(fields: [customerId], references: [id])
  customerId  Int
  product     Product      @relation(fields: [productId], references: [id])
  productId   Int
  quantity    Int          @default(1)
  monthlyRate Float        @default(0) // valor mensal por unidade
  startDate   DateTime
  expectedEnd DateTime? // devolução prevista
  returnedAt  DateTime? // devolução efetiva
  status      RentalStatus @default(ACTIVE)
  deliveryAddress String? // endereço de entrega do equipamento
  refCode     String? // nº do orçamento de origem
  notes       String?
  ownerId     Int? // usuário que criou (escopo por dono)
  shared      Boolean      @default(false)
  deletedAt   DateTime? // soft delete (lixeira)
  createdAt   DateTime     @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([status])
  @@index([ownerId])
  @@index([deletedAt])
}

// ------------------- Contratos de manutenção -------------------

// Manutenção recorrente. frequency define o intervalo; nextVisit é a próxima.
model MaintenanceContract {
  id         Int                  @id @default(autoincrement())
  title      String
  customer   Customer             @relation(fields: [customerId], references: [id])
  customerId Int
  frequency  MaintenanceFrequency @default(MONTHLY)
  value      Float                @default(0) // valor por visita
  nextVisit  DateTime?
  status     MaintenanceStatus    @default(ACTIVE)
  refCode    String? // nº do orçamento de origem
  notes      String?
  ownerId    Int? // usuário que criou (escopo por dono)
  shared     Boolean              @default(false)
  deletedAt  DateTime? // soft delete (lixeira)
  createdAt  DateTime             @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([status])
  @@index([ownerId])
  @@index([deletedAt])
}
