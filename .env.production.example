# Variáveis de ambiente para PRODUÇÃO (Vercel + Postgres + Blob).
# Configure-as em: Vercel → Project → Settings → Environment Variables.
# NÃO commite valores reais — este arquivo é só um modelo.

# --- Banco de dados PostgreSQL (Neon / Vercel Postgres) ---
# url = conexão "pooled" (runtime). directUrl = conexão direta (db push/migração).
DATABASE_URL="postgresql://usuario:senha@host-pooler.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@host.neon.tech/dbname?sslmode=require"

# --- Sessão (cookie assinado) ---
# Gere um valor forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="cole-aqui-uma-string-aleatoria-bem-longa"

# --- Armazenamento de anexos (Vercel Blob) ---
# Criado automaticamente ao conectar um Blob Store ao projeto na Vercel.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"
