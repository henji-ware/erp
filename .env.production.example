# Variáveis de ambiente para PRODUÇÃO (Vercel + Postgres + Blob).
# Configure-as em: Vercel → Project → Settings → Environment Variables.
# NÃO commite valores reais — este arquivo é só um modelo.

# --- Banco de dados PostgreSQL (Neon / Vercel Postgres) ---
# url = conexão "pooled" (runtime). directUrl = conexão direta (db push/migração).
DATABASE_URL="postgresql://usuario:senha@host-pooler.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@host.neon.tech/dbname?sslmode=require"

# --- Sessão (cookie assinado) ---
# Gere um valor forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="cole-aqui-uma-string-aleatoria-bem-longa"

# --- Cifra das chaves de API de IA guardadas por usuário ---
# As chaves que cada pessoa cadastra em Configurações > Inteligência Artificial
# são gravadas CIFRADAS no banco (AES-256-GCM). Esta é a chave mestre.
# Gere igual ao SESSION_SECRET:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# ATENÇÃO: trocar este valor torna as chaves já guardadas ilegíveis, e cada
# usuário precisa cadastrar a dele de novo. O sistema continua funcionando —
# a tela avisa e cai na chave do .env, se houver —, mas não há como recuperar.
#
# Sem esta variável o sistema usa o SESSION_SECRET como origem. Funciona, mas
# amarra as duas coisas: girar o segredo de sessão passaria a derrubar as
# chaves de IA junto. Defina uma própria.
AI_ENCRYPTION_KEY="cole-aqui-outra-string-aleatoria-bem-longa"

# --- Armazenamento de anexos (Vercel Blob) ---
# Criado automaticamente ao conectar um Blob Store ao projeto na Vercel.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# --- E-mail (Resend) ---
# Chave da API do Resend (resend.com → API Keys). Sem ela, o app funciona,
# mas não envia e-mails (verificação, reset e avisos ficam desativados).
RESEND_API_KEY="re_xxxxxxxx"
# Remetente. Para usar o seu domínio, verifique-o no Resend (registros DNS).
# Enquanto não verificar, use: "DRR Projetos <onboarding@resend.dev>".
EMAIL_FROM="DRR Projetos <nao-responda@drrprojetos.com.br>"

# --- URL pública do app (links nos e-mails) ---
APP_URL="https://erp-genuinz.vercel.app"

# --- Segredo do cron de avisos de prazo (Vercel Cron) ---
# Gere: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET="cole-aqui-um-segredo-aleatorio"
